{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/ai/parse-invoice",
      "destination": "/api/ai/parse-invoice"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
