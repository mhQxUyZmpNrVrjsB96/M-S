# ==============================================================================
# .env.example - ESEMPIO DI CONFIGURAZIONE PUBBLICA PER GITHUB
# Copia questo file in .env per lo sviluppo locale senza caricare credenziali segrete.
# ==============================================================================

# Chiave privata Gemini AI (solo lato server, mai esposta nel frontend)
GEMINI_API_KEY="INSERISCI_QUI_LA_TUA_GEMINI_API_KEY"

# URL applicazione
APP_URL="MY_APP_URL"

# Configurazione Supabase (se si desidera sovrascrivere src/config/supabaseConfig.ts via environment variables)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
